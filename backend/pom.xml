<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.5</version>
        <relativePath/>
    </parent>

    <groupId>com.meiyetec</groupId>
    <artifactId>meiyetec-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>meiyetec-api</name>
    <description>美业SaaS系统后端API</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <jjwt.version>0.12.3</jjwt.version>
        <lombok.version>1.18.36</lombok.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring AOP for SysLog Aspect -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Boot JDBC (for JdbcTemplate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Apache POI for Excel export -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- BCrypt 密码编码器（仅 spring-security-crypto，不引入完整 Spring Security 过滤器链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>6.2.0</version>
        </dependency>

        <!-- DCEP 国密算法：SM2（签名/加密） + SM3（哈希） + SM4（对称加密） -->
        <!-- BouncyCastle 含完整 SM 算法实现，无需硬件设备即可在软件中验证 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- IoT-006：MQTT 客户端（HiveMQ MQTT Client 是当前最成熟的 Java MQTT 5 客户端） -->
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client</artifactId>
            <version>1.3.3</version>
        </dependency>

        <!-- EXT-09：插件运行时（org.pf4j — 成熟的 Java 插件框架） -->
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>3.10.0</version>
        </dependency>

        <!-- EXT-19：邮件渠道 — JavaMailSender（SMTP） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ============================================================
             监控基础设施（批次 1.4-A）
             - spring-boot-starter-actuator: /actuator/health,info + 自动带 Micrometer-core
             - micrometer-registry-prometheus: /actuator/prometheus 端点（Prometheus 抓取格式）
             版本由 spring-boot-dependencies BOM 锁（Spring Boot 3.1.5 → actuator 3.1.5 / micrometer 1.12.x）
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- AI-006：LaunchDarkly Feature Flag SDK（可选，feature.launchdarkly.enabled=true 启用） -->
        <dependency>
            <groupId>com.launchdarkly</groupId>
            <artifactId>launchdarkly-java-server-sdk</artifactId>
            <version>7.16.0</version>
        </dependency>

        <!-- EXT-P0-1：微信支付 V3 官方 SDK（com.github.wechatpay-apiv3:wechatpay-java） -->
        <dependency>
            <groupId>com.github.wechatpay-apiv3</groupId>
            <artifactId>wechatpay-java</artifactId>
            <version>0.2.17</version>
        </dependency>

        <!-- EXT-P0-1：支付宝官方 SDK（alipay-sdk-java ALL 版本，包含完整 API） -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>4.40.984.ALL</version>
        </dependency>

        <!-- ============================================================
             Flyway 数据库迁移（启动期自动 apply db/migration/V*.sql）
             版本由 spring-boot-dependencies BOM 管理 (9.22.x for Spring Boot 3.1.5)
             flyway-mysql 是 9.x 后拆分的 MySQL 专属适配器（flyway-core 自带 generic）
             ============================================================ -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <sourceExcludes>
                        <sourceExclude>**/service/IoTDeviceService.java</sourceExclude>
                        <sourceExclude>**/service/impl/IotDeviceServiceImpl.java</sourceExclude>
                        <sourceExclude>**/controller/IotDeviceController.java</sourceExclude>
                        <sourceExclude>**/iot/IotDeviceAdapter.java</sourceExclude>
                        <sourceExclude>**/service/OverseasPaymentGatewayService.java</sourceExclude>
                        <sourceExclude>**/service/OverseasPaymentGatewayAdapter.java</sourceExclude>
                        <sourceExclude>**/payment/PaypalAdapter.java</sourceExclude>
                        <sourceExclude>**/payment/OverseasPaymentAdapter.java</sourceExclude>
                        <sourceExclude>**/service/impl/PaypalAdapter.java</sourceExclude>
                        <sourceExclude>**/controller/OverseasPaymentGatewayController.java</sourceExclude>
                        <sourceExclude>**/service/impl/OverseasPaymentGatewayServiceImpl.java</sourceExclude>
                        <sourceExclude>**/service/InventoryConsumptionService.java</sourceExclude>
                        <sourceExclude>**/engine/CareSuggestionEngine.java</sourceExclude>
                        <sourceExclude>**/controller/StockController.java</sourceExclude>
                        <sourceExclude>**/service/P3EcosystemService.java</sourceExclude>
                        <sourceExclude>**/service/impl/ResourceScheduleServiceImpl.java</sourceExclude>
                        <sourceExclude>**/service/impl/StyleLibraryServiceImpl.java</sourceExclude>
                        <sourceExclude>**/service/impl/ServiceMaterialDeductServiceImpl.java</sourceExclude>
                        <sourceExclude>**/service/impl/IotTriggerRuleServiceImpl.java</sourceExclude>
                        <sourceExclude>**/service/impl/DcepSmartContractServiceImpl.java</sourceExclude>
                        <sourceExclude>**/service/impl/BookingServiceImpl.java</sourceExclude>
                        <sourceExclude>**/service/BookingResourceService.java</sourceExclude>
                        <sourceExclude>**/service/impl/BnplServiceImpl.java</sourceExclude>
                    </sourceExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
