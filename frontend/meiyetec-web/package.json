{
  "name": "meiyetec-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:strict": "vue-tsc -b && vite build",
    "build:check": "vue-tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium --with-deps",
    "e2e:ci": "cross-env CI=true playwright test --project=chromium --project=\"Mobile Chrome\" --reporter=line",
    "e2e:ci:chromium": "cross-env CI=true playwright test --project=chromium --reporter=line",
    "e2e:ci:mobile": "cross-env CI=true playwright test --project=\"Mobile Chrome\" --reporter=line",
    "e2e:new-modules": "playwright test new-modules.spec.ts --project=chromium",
    "e2e:business-flow": "playwright test business-flow.spec.ts --project=chromium"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.19.0",
    "echarts": "^5.5.1",
    "element-plus": "^2.14.3",
    "nprogress": "^0.2.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^25.0.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.2.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.8"
  }
}
