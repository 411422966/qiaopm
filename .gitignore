# =====================
# 15. audit/scripts/ 临时调试产物（_ 前缀约定）
# =====================
# 防止一次性 insert / python / grep 输出污染仓库
# 真实证据请放 audit/evidence/<feature>/，根目录不留
audit/scripts/_*.txt
audit/scripts/_*.py
audit/scripts/_*.log
audit/scripts/_*.json

# audit 巡检脚本（数字前缀为长期资产，非临时）
!audit/scripts/[0-9][0-9]-*.ps1
!audit/scripts/[0-9][0-9][0-9]-*.ps1

# 数据库迁移前备份（一次性快照，不入库）
audit/baseline/*-backup-*.sql

# I116 演练 SQL 快照（10MB，本地留存，不入库）
audit/evidence/*/full_backup.sql

# I123 数据库备份产物（不入库）
backup/*.sql
backup/*.sql.gz
backup/logs/*.log

# I123 备份脚本（长期资产，需入库）
!scripts/backup-db-docker.ps1
backup/
audit/baseline/.tmp-sql/

audit-tmp-*
audit-tpm-*
\
