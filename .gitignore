# scripts dir at workspace root
# 策略：精确 ignore 文件名（避免 /scripts/ 或 /scripts/* 隐式排除整个目录）
# 这是 git 限制：「It is not possible to re-include a file if a parent directory is excluded」
# 一次性 dev 脚本不入仓，运维脚本 .sh 默认 tracked + 显式白名单
/scripts/fix_lbs.py
/scripts/verify-B1-B4.ps1
/scripts/.token
/scripts/.commit-msg-2.3.txt
/scripts/.commit-msg-b-docs.txt
# 显式白名单 — 运维脚本（防御性，主目录已默认 tracked）
!/scripts/backup-db.sh
!/scripts/restore-db.sh
!/scripts/cleanup-local-backups.sh
# 子目录（如 recovery/）默认 tracked；其下 .ps1 被全局 *.ps1 忽略，需显式 allowlist
!/scripts/recovery/**/*.ps1
