# ============================================================
# 美业科技 · 环境变量示例（PROD ENV MANIFEST 速查版）
# 复制本文件为 .env 并填入真实值，勿将 .env 提交到 Git
#
# 对应文档：docs/prod-env-manifest.md（事实源，校验规则更详细）
# 对应配置：backend/src/main/resources/application.yml（base）
#         backend/src/main/resources/application-prod.yml（prod 强约束）
#
# 格式约定：
#   # 描述
#   ENV_NAME=描述性默认值   ← 留空表示「prod 必须从外部注入」
#   # ENV_NAME=dev-only    ← 仅 dev 用，prod 必替换
# ============================================================

# -------------------- Server --------------------
# 监听端口（base 默认 8080；prod 通常 8080 或 80 走反向代理）
SERVER_PORT=8080

# -------------------- JWT 配置 --------------------
# 【必填 · 生产】JWT 签名密钥
#   - 必须 ≥ 32 字节，建议使用随机字符串（可用 openssl rand -base64 48 生成）
#   - 禁止包含 "meiyetec" / "dev-only" / "test-only" / "not-for-production" 等标识
#   - 生产环境务必设置，否则启动时 `JwtUtil` 校验会 fail-fast
JWT_SECRET=your-production-secret-at-least-32-chars-here

# JWT token 过期时间（毫秒），prod 默认 2h（base dev 24h）
JWT_EXPIRATION=7200000

# JWT refresh 宽限期（毫秒），默认 604800000 = 7天
JWT_REFRESH_GRACE_MS=604800000

# -------------------- 数据库配置 --------------------
# 【必填 · 生产】数据库连接信息
#   - 生产环境务必替换为真实地址 + SSL（application-prod.yml 已强制 useSSL=true）
#   - 禁止使用默认值 root123456
SPRING_DATASOURCE_URL=jdbc:mysql://prod-rds-host:3306/meiyetec?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_bin&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true&verifyServerCertificate=true
SPRING_DATASOURCE_USERNAME=meiyetec_app
SPRING_DATASOURCE_PASSWORD=your-production-db-password-here

# -------------------- Flyway 数据库迁移 --------------------
# 【必填 · 生产】是否启用 Flyway
#   - prod 必须设为 true（否则 schema 演进无 migration 痕迹）
#   - 修复 I010 V1 编码问题前可临时设 false（仅限紧急恢复）
FLYWAY_ENABLED=true

# -------------------- Redis 配置 --------------------
# 【必填 · 生产】Redis 连接信息
#   - prod 不允许 localhost（容器/服务模式下找不到 host）
#   - 即使内网也建议设 password（prod 强约束）
SPRING_DATA_REDIS_HOST=prod-redis-host
SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=your-redis-password

# -------------------- 雪花 ID 生成器 --------------------
# 【必填 · 生产】分布式部署时每台机器必须设置不同的 worker-id 和 datacenter-id（0-31）
#   - 单机部署可保留 0/0
#   - 多实例部署：每台 POD 的 worker_id 必须不同（否则主键冲突）
APP_ID_GENERATOR_WORKER_ID=0
APP_ID_GENERATOR_DATACENTER_ID=0

# -------------------- DCEP 数字人民币配置 --------------------
# 【必填 · 生产】DCEP 部署模式
#   - dev    : Mock 模式（仅本地开发，prod 禁止）
#   - prod   : 严格生产模式（fail-safe，禁止 Mock 行为）
APP_DCEP_MODE=prod

# -------------------- DCEP AI 视觉推理 Provider --------------------
# 优先级：腾讯云 → 阿里云 → 本地推理 → Mock
# 凭证不得写死在 YAML — 必须从 ENV 注入

# 腾讯云视觉（https://console.cloud.tencent.com/cam/capi）
# APP_DCEP_AI_TENCENT_SECRET_ID=AKIDxxx
# APP_DCEP_AI_TENCENT_SECRET_KEY=your-tencent-secret-key
# APP_DCEP_AI_TENCENT_APP_ID=1250000000
# APP_DCEP_AI_TENCENT_REGION=ap-guangzhou

# 阿里云视觉（https://ram.console.aliyun.com/manage/ak）
# APP_DCEP_AI_ALIYUN_ACCESS_KEY_ID=your-aliyun-ak-id
# APP_DCEP_AI_ALIYUN_ACCESS_KEY_SECRET=your-aliyun-ak-secret
# APP_DCEP_AI_ALIYUN_REGION_ID=cn-shanghai

# 本地推理服务（TensorFlow Serving / TorchServe / ONNX Runtime）
# APP_DCEP_AI_LOCAL_ENDPOINT=http://gpu-server:8081/infer
# APP_DCEP_AI_LOCAL_TIMEOUT_MS=5000

# -------------------- 国内支付（微信 / 支付宝 / 银联） --------------------
# 【必填 · 生产】支付环境
#   - sandbox     : 仅本地开发，prod 禁止
#   - production  : 真实生产
APP_CN_PAY_ENV_MODE=production
APP_CN_PAY_NOTIFY_URL=https://api.meiyetec.com/domestic/webhook

# 微信支付 V3（生产从商户平台获取）
# APP_CN_PAY_WECHAT_APP_ID=wx0000000000000000
# APP_CN_PAY_WECHAT_MCH_ID=your-merchant-id
# APP_CN_PAY_WECHAT_API_V3_KEY=your-32-bytes-api-v3-key
# APP_CN_PAY_WECHAT_KEY_PATH=/etc/meiyetec/keys/wechat/apiclient_key.pem
# APP_CN_PAY_WECHAT_CERT_SERIAL=your-cert-serial-no
# APP_CN_PAY_WECHAT_CERT_PATH=/etc/meiyetec/keys/wechat/apiclient_cert.pem

# 支付宝 V4（生产从开放平台获取）
# APP_CN_PAY_ALIPAY_APP_ID=2021000000000000
# APP_CN_PAY_ALIPAY_PRIVATE_KEY=your-alipay-private-key
# APP_CN_PAY_ALIPAY_PUBLIC_KEY=your-alipay-public-key
# APP_CN_PAY_ALIPAY_SIGN_TYPE=RSA2
# APP_CN_PAY_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 银联云闪付
# APP_CN_PAY_UNION_ENABLED=false
# APP_CN_PAY_UNION_MER_ID=
# APP_CN_PAY_UNION_SIGN_CERT=
# APP_CN_PAY_UNION_SIGN_PWD=
# APP_CN_PAY_UNION_ENCRYPT_CERT=
# APP_CN_PAY_UNION_MIDDLE_CERT=
# APP_CN_PAY_UNION_ROOT_CERT=

# -------------------- 财税开票 --------------------
# 【必填 · 生产】开票网关模式
#   - mock            : 仅本地开发
#   - baiwang-sandbox : 百望沙箱（联调用）
#   - baiwang         : 百望正式（生产）
FISCAL_MODE=baiwang
FISCAL_CONNECT_TIMEOUT_MS=5000
FISCAL_READ_TIMEOUT_MS=15000
FISCAL_RETRY_MAX=2

# -------------------- CRM 同步排程 --------------------
# 调度器扫描频率（每 5 分钟过一遍所有集成）
CRM_SYNC_TICK_MS=300000

# -------------------- 插件运行时（pf4j） --------------------
# 【必填 · 生产】插件 jar 根目录
#   - 必须是绝对路径（容器/服务模式下相对路径失效）
PLUGIN_PLUGINS_ROOT=/opt/meiyetec/plugins
PLUGIN_RUNTIME_ENABLED=true
# prod 建议关闭自动加载（人工审核后再 load）
PLUGIN_AUTOLOAD=false

# -------------------- IoT / MQTT（HiveMQ） --------------------
# 真实部署才需要启用（未启用时 MqttClientService @ConditionalOnProperty 不激活）
IOT_MQTT_ENABLED=false
IOT_MQTT_HOST=hivemq-cluster-host
# prod 默认 8883（TLS）— base dev 默认 1883
IOT_MQTT_PORT=8883
# IOT_MQTT_USERNAME=your-mqtt-user
# IOT_MQTT_PASSWORD=your-mqtt-password

# -------------------- LaunchDarkly Feature Flag --------------------
# 灰度发布后端（生产启用时必填）
LAUNCHDARKLY_ENABLED=false
# LAUNCHDARKLY_SDK_KEY=your-ld-sdk-key

# -------------------- BNPL（先买后付） --------------------
# Klarna（生产启用时必填）
# KLARNA_BASE_URL=https://api.klarna.com
# KLARNA_CLIENT_ID=your-klarna-client-id
# KLARNA_CLIENT_SECRET=your-klarna-client-secret
# KLARNA_MERCHANT_ID=your-klarna-merchant-id
# KLARNA_TEST_MODE=false

# Afterpay（生产启用时必填）
# AFTERPAY_BASE_URL=https://api.afterpay.com
# AFTERPAY_MERCHANT_ID=your-afterpay-merchant-id
# AFTERPAY_SECRET_KEY=your-afterpay-secret-key
# AFTERPAY_PUBLIC_KEY=your-afterpay-public-key
# AFTERPAY_TEST_MODE=false

# -------------------- Kiosk 告警（运营阈值） --------------------
KIOSK_ALERT_ENABLED=true
KIOSK_ALERT_INFO_MIN=5
KIOSK_ALERT_WARN_MIN=15
KIOSK_ALERT_CRITICAL_MIN=30
KIOSK_ALERT_SCAN_MS=60000
KIOSK_ALERT_PUSH_ENABLED=true
KIOSK_ALERT_PUSH_CHANNEL=IN_APP
KIOSK_ALERT_COOLDOWN_MIN=30
KIOSK_DAILY_TARGET_DEFAULT=80
